<section class="sign-section">
    <div class="sign-container">
        <h1>Welcome, please create <br> your account discover more</h1>
        <form action="/api/signup" method="post" id="sign-up-form" novalidate>
        <div class="form-input">
            <label for="username">User Name</label>
            <input type="text" name="username" placeholder="Enter a username" autocomplete="off" id="username-sign-up" required>
            <div class="form-msg" id="username-msg-info"></div>
        </div>
        <div class="form-input">
            <label for="email">Email</label>
            <input type="email" name="email" placeholder="Enter a valid email" autocomplete="off" id="email-sign-up" required>
            <div class="form-msg" id="email-msg-info"></div>
        </div>
        <div class="form-input">
            <label for="password">Password</label>
            <div class="form-pswd-input">
            <input type="password" name="password" placeholder="Enter a password" id="pswd-sign-up" required>
            <button type="button" id="opt-display" aria-label="show or hide">👁️</button>
            </div>
            <div class="form-msg" id="pswd-msg-info"></div>
        </div>

        <p class="rule" id="rule-1">must contains at least 8 characters</p>
        <p class="rule" id="rule-2">must contains a least one special character</p>
        <p class="rule" id="rule-3">must contains a least two numbers</p>

        <div class="form-input">
            <label for="confirm-pswd">Confirm Password</label>
            <div class="form-pswd-input">
            <input type="password" name="confirm-pswd" placeholder="Confirm your password" id="confirm-pswd-sign-up" required>
            <button type="button" id="confirm-opt-display" aria-label="show or hide">👁️</button>
            </div>
            <div class="form-msg" id="confirm-pswd-msg-info"></div>
        </div>
        <button type="submit" class="btn-sign" id="btn-sign-up">Sign up</button>
        </form>
        <span>You already have an account?<a href="/Signin" class="btn-ber-sign-in">Sign in</a></span>
    </div>
</section>